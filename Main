#13.02.2026 Печерин Егор ИИ-71 уровень: B

№1
Сложность линейной сортировки выше. Сложность бинарной сортировки является O(Log n), достигнутая за счет использования бинарного дерева поиска, что позволяет сократить кол-во пересечений

 №2
import random

list = []
n = int(input())
anwser = 0

for i in range(n):
    num = random.randint(0, 100000)
    list.append(num)
print(list)

for i in range(len(list)):
    sum_pairs = list[i] + list[i-1]
    if sum_pairs % 2 != 0:
        anwser += 1

print(anwser)

№3
import random

list_1 = []
list_2 = []
n_1 = int(input(': '))
n_2 = int(input(': '))
anwser = 0

for i in range(n_1):
    num = random.randint(0, 100000)
    list_1.append(num)

print(list_1.sort())

for i in range(n_2):
    num = random.randint(0, 100000)
    list_2.append(num)

print(list_1.sort())

list_1.append(list_2)


def sort():
    for i in range(len(list_1)):
        min_index = i
        for j in range(i + 1, len(list_1)):
            if list_1[j] < list_1[min_index]:
                min_index = j
            list_1[i], list_1[min_index] = list_1[min_index], list_1[i]
        return list_1

sort()

№4
Линейный поиск справляется со списками из эллементов с маленькими разницами и большими примерно ожинаково: 15.40 мб
Бинарный поиск справился с такими же списками за: 15.11 мб
По исходам данного теста, можно понять что бинарный поиск требует меньше памяти, чем линейный поиск

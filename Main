import networkx as nx
import matplotlib.pyplot as plt

G = nx.Graph()

edges = [
    (0, 1, 4),
    (0, 4, 2),
    (1, 2, 1),
    (2, 3, 3),
    (2, 4, 5),
    (3, 4, 1)
]

G.add_weighted_edges_from(edges)


# № 1
def find_max_degree_node(graph):
    max_edges = -1
    best_node = -1

    for node in graph.nodes():
        current_degree = graph.degree[node]

        if current_degree > max_edges:
            max_edges = current_degree
            best_node = node

    return best_node, max_edges


node, count = find_max_degree_node(G)
print(f"Узел с максимальным количеством ребер: {node} (всего ребер: {count})")


# №3
def run_dijkstra(graph, start_node):
    distances = nx.single_source_dijkstra_path_length(graph, start_node, weight='weight')
    return distances


start = 0
shortest_paths = run_dijkstra(G, start)
print(f"Кратчайшие расстояния от узла {start}:")
for node, dist in shortest_paths.items():
    print(f"До узла {node}: {dist}")


# №2
def draw_graph(graph):
    plt.figure(figsize=(8, 6))

    pos = nx.spring_layout(graph, seed=42)

    nx.draw_networkx_nodes(graph, pos, node_size=700, node_color='lightblue', edgecolors='black')

    nx.draw_networkx_labels(graph, pos, font_size=16)

    nx.draw_networkx_edges(graph, pos, width=2)

    edge_labels = nx.get_edge_attributes(graph, 'weight')
    nx.draw_networkx_edge_labels(graph, pos, edge_labels=edge_labels, font_color='red', font_size=12)

    plt.show()


draw_graph(G)
